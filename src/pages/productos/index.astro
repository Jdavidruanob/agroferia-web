---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import LineaBanda from '../../components/LineaBanda.astro';
import PalArranqueLetras from '../../components/PalArranqueLetras.astro';
import TradicionalLetras from '../../components/TradicionalLetras.astro';
import { grupos, lineaPorKey, productosDeGrupo } from '../../data/productos';

const gruposPA = grupos.filter((g) => g.linea === 'pal-arranque');
---

<Base title="Productos" description="Portafolio de Agroferia: la línea Pal' Arranque para ciclistas y la línea Agroferia Tradicional, todos productos artesanales de La Feria.">
  <section class="container phero" aria-labelledby="ph-title">
    <h1 id="ph-title">Nuestros productos</h1>
    <p class="lead">
      Dos líneas, hechas a mano con la leche de las 30 familias de La Feria. Entra a cada producto para ver sus ingredientes,
      cómo conservarlo y qué lleva.
    </p>
    <nav class="tabs" aria-label="Líneas de producto">
      <a class="tabs__link tabs__link--tr" href="#tradicional">Agroferia Tradicional</a>
      <a class="tabs__link tabs__link--pa" href="#pal-arranque">Pal' Arranque</a>
    </nav>
  </section>

  <!-- ===================== AGROFERIA TRADICIONAL ===================== -->
  <section id="tradicional" class="container linea" aria-labelledby="t-tr">
    <LineaBanda linea="tradicional">
      <h2 id="t-tr" class="linea__brand"><TradicionalLetras width={300} alt="Agroferia Tradicional" /></h2>
      <p class="linea__desc">{lineaPorKey.tradicional.descripcion}</p>
    </LineaBanda>

    <div class="grupo grupo--tr">
      <ul class="grid">
        {
          productosDeGrupo('tradicional').map((p) => (
            <li>
              <ProductCard producto={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== PAL' ARRANQUE ===================== -->
  <section id="pal-arranque" class="container linea" aria-labelledby="t-pa">
    <LineaBanda linea="pal-arranque">
      <h2 id="t-pa" class="linea__brand"><PalArranqueLetras width={280} /></h2>
      <p class="linea__desc">{lineaPorKey['pal-arranque'].descripcion}</p>
      <a class="btn btn--sun" href="/pal-arranque">
        Conoce el programa
        <span class="btn__arrow"><Icon name="arrow-right" size={18} /></span>
      </a>
    </LineaBanda>

    {
      gruposPA.map((g) => (
        <div id={g.key} class="grupo grupo--pa">
          <div class="grupo__head">
            <h3>{g.nombre}</h3>
            <p>{g.descripcion}</p>
          </div>
          <ul class="grid">
            {productosDeGrupo(g.key).map((p) => (
              <li>
                <ProductCard producto={p} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .phero {
    padding: clamp(56px, 8vw, 96px) 0 clamp(28px, 4vw, 40px);
  }
  .phero .lead {
    margin-top: 18px;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .tabs__link {
    padding: 11px 20px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.3s var(--ease-out), box-shadow 0.2s ease;
  }
  .tabs__link:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -12px rgb(17 24 39 / 0.45);
  }
  .tabs__link--pa {
    background: var(--blue);
    color: #fff;
  }
  .tabs__link--tr {
    background: var(--orange);
    color: var(--on-orange);
  }

  .linea {
    padding-top: clamp(32px, 5vw, 56px);
    scroll-margin-top: 110px;
  }
  .linea__brand {
    line-height: 0;
    margin-left: -6px;
  }
  .linea__desc {
    max-width: 52ch;
    margin: 12px 0 22px;
    font-size: 1.08rem;
  }
  :global(.banda--pa) .linea__desc {
    color: var(--ink-on-blue-2);
  }

  .grupo {
    padding: clamp(32px, 4vw, 44px) 0 8px;
    scroll-margin-top: 110px;
  }
  .grupo__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 20px;
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--blue);
  }
  .grupo__head h3 {
    color: var(--blue);
    font-family: var(--font-sport);
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
  }
  .grupo__head p {
    color: var(--ink-2);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
