---
/** Sello "Producto Lácteo Artesanal". Es un botón: al hacer clic se abre en grande (ver SelloLightbox). */
import { Image } from 'astro:assets';
import sello from '../assets/marca/sello-artesanal.png';

interface Props {
  /** Ancho visible en px. */
  size?: number;
  class?: string;
}
const { size = 72, class: className } = Astro.props;
---

<button type="button" class:list={['sello', className]} data-sello-abrir aria-label="Ver en grande el sello Producto Lácteo Artesanal" style={`--s:${size}px`}>
  <Image src={sello} alt="" width={Math.min(size * 2, 400)} height={Math.min(size * 2, 400)} />
</button>

<style>
  .sello {
    display: block;
    width: var(--s);
    height: var(--s);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 2px #fff, 0 6px 14px -6px rgb(17 24 39 / 0.45);
    cursor: zoom-in;
    transform: rotate(-8deg);
    transition: transform 0.45s var(--ease-out), box-shadow 0.3s ease;
  }
  .sello:hover,
  .sello:focus-visible {
    transform: rotate(0deg) scale(1.08);
    box-shadow: 0 0 0 2px #fff, 0 10px 22px -8px rgb(17 24 39 / 0.55);
  }
  .sello:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }
  .sello :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }
</style>
