---
import { Image } from 'astro:assets';
import sello from '../assets/marca/sello-artesanal.png';
import ProductGlyph from './ProductGlyph.astro';
import Icon from './Icon.astro';
import { esPalArranque, lineaPorKey, productoUrl, type Producto } from '../data/productos';

interface Props {
  producto: Producto;
  /** Oculta el párrafo de receta (carruseles compactos). */
  compacta?: boolean;
}

const { producto: p, compacta = false } = Astro.props;
const pa = esPalArranque(p);
const linea = lineaPorKey[p.linea];
---

<a class:list={['pcard', pa ? 'pcard--pa' : 'pcard--tradicional']} href={productoUrl(p)}>
  <div class="pcard__media">
    <!--
      PENDIENTE: foto del producto. Reemplazar el ícono por:
      <img src="/productos/SLUG.jpg" alt="NOMBRE DEL PRODUCTO" loading="lazy" />
    -->
    <ProductGlyph name={p.glyph} size={96} class="pcard__glyph" />
    <span class="pcard__badges">
      <span class:list={['badge', pa ? 'badge--pa' : 'badge--tradicional']}>{linea.nombre}</span>
      <span class:list={['badge', 'badge--artesanal', pa ? 'is-pa' : 'is-tradicional', 'pcard__craft']}>
        {p.etiqueta === 'Edición Especial · Ecológico' && <Icon name="leaf" size={13} />}
        {p.etiqueta}
      </span>
    </span>
    <Image class="pcard__sello" src={sello} alt="Sello Producto Lácteo Artesanal" width={160} height={160} />
  </div>
  <div class="pcard__body">
    <h3 class="pcard__name">{p.nombre}</h3>
    {!compacta && <p class="pcard__recipe">{p.receta}</p>}
    <span class="pcard__foot">
      <span class="pcard__format">{p.presentacion.split(',')[0]}</span>
      <span class="pcard__more">
        {p.nutricion ? 'Ver ficha' : 'Ver detalles'}
        <span class="pcard__arrow"><Icon name="arrow-right" size={16} /></span>
      </span>
    </span>
  </div>
</a>

<style>
  .pcard {
    --line-color: var(--orange);
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.3s ease, transform 0.4s var(--ease-out);
  }
  .pcard--pa {
    --line-color: var(--blue);
  }
  .pcard:hover {
    transform: translateY(-3px);
    border-color: var(--line-color);
    box-shadow: 0 18px 36px -20px rgb(17 24 39 / 0.35);
  }

  .pcard__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background: var(--panel);
    color: var(--line-color);
  }
  .pcard__media :global(img:not(.pcard__sello)) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pcard__media :global(.pcard__glyph) {
    transition: transform 0.5s var(--ease-out);
  }
  .pcard:hover .pcard__media :global(.pcard__glyph) {
    transform: scale(1.06) rotate(-3deg);
  }
  .pcard__badges {
    position: absolute;
    z-index: 1;
    top: 10px;
    left: 10px;
    right: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: space-between;
  }
  .pcard__craft {
    margin-left: auto;
  }
  /* Sello artesanal: esquina inferior derecha de la imagen, por encima de la foto */
  .pcard__media :global(.pcard__sello) {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 1;
    width: clamp(56px, 22%, 76px);
    height: auto;
    border-radius: 50%;
    box-shadow: 0 0 0 2px #fff, 0 6px 14px -6px rgb(17 24 39 / 0.45);
    transform: rotate(-8deg);
    transition: transform 0.5s var(--ease-out);
  }
  .pcard:hover .pcard__media :global(.pcard__sello) {
    transform: rotate(0deg) scale(1.05);
  }

  .pcard__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 18px 18px 16px;
  }
  .pcard__name {
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .pcard__recipe {
    color: var(--ink-2);
    font-size: 0.93rem;
    line-height: 1.55;
  }
  .pcard__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .pcard__format {
    color: var(--ink-2);
    font-size: 0.82rem;
  }
  .pcard__more {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
    color: var(--blue);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .pcard__arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    transition: transform 0.35s var(--ease-out);
  }
  .pcard--tradicional .pcard__arrow {
    background: var(--orange);
    color: var(--on-orange);
  }
  .pcard:hover .pcard__arrow {
    transform: translateX(3px);
  }
</style>
