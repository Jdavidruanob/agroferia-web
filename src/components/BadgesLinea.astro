---
/** Par de etiquetas de producto: línea + artesanal. */
import Icon from './Icon.astro';
import { esPalArranque, lineaPorKey, type Producto } from '../data/productos';

interface Props {
  producto: Producto;
  class?: string;
}
const { producto: p, class: className } = Astro.props;
const pa = esPalArranque(p);
---

<span class:list={['badges', className]}>
  <span class:list={['badge', pa ? 'badge--pa' : 'badge--tradicional']}>{lineaPorKey[p.linea].nombre}</span>
  <span class:list={['badge', 'badge--artesanal', pa ? 'is-pa' : 'is-tradicional']}>
    {p.etiqueta === 'Edición Especial · Ecológico' && <Icon name="leaf" size={13} />}
    {p.etiqueta}
  </span>
</span>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
