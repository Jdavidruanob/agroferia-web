---
/** Distintivo de la línea Tradicional: cinta verde con las letras de su etiqueta. */
import { Image } from 'astro:assets';
import letras from '../assets/marca/tradicional-letras.png';

interface Props {
  /** Alto de las letras en px. */
  size?: number;
  class?: string;
}
const { size = 15, class: className } = Astro.props;
---

<span class:list={['badge-tradicional', className]}>
  <Image src={letras} alt="Línea Tradicional" height={size * 2} style={`height:${size}px`} />
</span>
