---
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo-agroferia.png';
import Icon from './Icon.astro';
import PalArranqueLetras from './PalArranqueLetras.astro';
import TradicionalLetras from './TradicionalLetras.astro';
import { grupos, productosDeGrupo, productoUrl } from '../data/productos';
import { whatsapp, waUrl } from '../data/contacto';

const gruposPA = grupos.filter((g) => g.linea === 'pal-arranque');

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const is = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/productos', label: 'Productos', mega: true },
  { href: '/pal-arranque', label: "Pal' Arranque" },
  { href: '/nosotros', label: 'Nosotros' },
];
---

<!-- Barra superior de contacto: se queda arriba al hacer scroll -->
<div class="topbar">
  <div class="container topbar__inner">
    <p class="topbar__place">
      <Icon name="map-pin" size={15} />
      Centro de Acopio · La Feria, Pradera, Valle del Cauca
    </p>
    <ul class="topbar__wa" aria-label="WhatsApp de Agroferia">
      <li>
        <a href={waUrl(whatsapp.principal.numero)} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={17} />
          <span class="topbar__label">WhatsApp</span>
          <strong>{whatsapp.principal.etiqueta}</strong>
        </a>
      </li>
      <li>
        <a href={waUrl(whatsapp.alterno.numero)} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={17} />
          <span class="topbar__label">Alterno</span>
          <strong>{whatsapp.alterno.etiqueta}</strong>
        </a>
      </li>
    </ul>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Agroferia, ir al inicio">
      <Image src={logo} alt="" width={120} height={113} loading="eager" />
    </a>

    <nav class="nav" aria-label="Principal">
      <ul class="nav__list">
        {
          links.map((l) =>
            l.mega ? (
              <li class="nav__item nav__item--mega" data-mega>
                <button
                  class="nav__link"
                  type="button"
                  aria-expanded="false"
                  aria-controls="mega-productos"
                  aria-current={is(l.href) ? 'page' : undefined}
                  data-mega-toggle
                >
                  {l.label}
                  <Icon name="chevron-down" size={16} class="nav__chev" />
                </button>
                <div class="mega" id="mega-productos" data-mega-panel hidden>
                  <div class="mega__grid">
                    <div class="mega__col mega__col--tr">
                      <a class="mega__title mega__title--tr" href="/productos#tradicional" aria-label="Agroferia Tradicional"><TradicionalLetras width={150} alt="" /></a>
                      <ul>
                        {productosDeGrupo('tradicional').map((p) => (
                          <li>
                            <a href={productoUrl(p)}>{p.nombre}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="mega__col mega__col--pa">
                      <a class="mega__title mega__title--pa" href="/pal-arranque">
                        <PalArranqueLetras width={170} />
                      </a>
                      <div class="mega__subs">
                        {gruposPA.map((g) => (
                          <div>
                            <a class="mega__sub" href={`/productos#${g.key}`}>{g.nombre}</a>
                            <ul>
                              {productosDeGrupo(g.key).map((p) => (
                                <li>
                                  <a href={productoUrl(p)}>{p.nombre}</a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                      <a class="mega__route" href="/pal-arranque#mapa">
                        <Icon name="route" size={16} />
                        Mapa del recorrido
                      </a>
                    </div>
                  </div>
                  <a class="mega__all" href="/productos">
                    Ver todos los productos <Icon name="arrow-right" size={16} />
                  </a>
                </div>
              </li>
            ) : (
              <li class="nav__item">
                {l.href === '/pal-arranque' ? (
                  <a class="nav__link nav__link--pa" href={l.href} aria-current={is(l.href) ? 'page' : undefined}>
                    <PalArranqueLetras width={104} loading="eager" />
                  </a>
                ) : (
                  <a class="nav__link" href={l.href} aria-current={is(l.href) ? 'page' : undefined}>
                    {l.label}
                  </a>
                )}
              </li>
            ),
          )
        }
      </ul>

      <a class="nav__cta" href="/nosotros#visitanos">
        <Icon name="map-pin" size={18} />
        Visítanos
      </a>

      <button class="nav__burger" type="button" aria-expanded="false" aria-controls="menu-movil" data-burger>
        <Icon name="menu" size={22} class="i-open" />
        <Icon name="close" size={22} class="i-close" />
        <span class="visually-hidden">Abrir menú</span>
      </button>
    </nav>
  </div>

  <!-- Menú móvil -->
  <div class="mobile" id="menu-movil" data-mobile hidden>
    <ul class="mobile__list">
      <li><a href="/" aria-current={is('/') ? 'page' : undefined}>Inicio</a></li>
      <li>
        <details>
          <summary>Productos <Icon name="chevron-down" size={18} /></summary>
          <div class="mobile__cats">
            {
              grupos.map((g) => (
                <div>
                  <p class:list={['mobile__cat', g.linea === 'pal-arranque' ? 'is-pa' : 'is-tr']}>
                    {g.linea === 'pal-arranque' ? `Pal' Arranque · ${g.nombre}` : g.nombre}
                  </p>
                  <ul>
                    {productosDeGrupo(g.key).map((p) => (
                      <li>
                        <a href={productoUrl(p)}>{p.nombre}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
            <a class="mobile__all" href="/productos">Ver todos los productos</a>
          </div>
        </details>
      </li>
      <li>
        <a href="/pal-arranque" aria-current={is('/pal-arranque') ? 'page' : undefined}>
          <span class="mobile__pa"><PalArranqueLetras width={130} /></span>
        </a>
      </li>
      <li><a href="/nosotros" aria-current={is('/nosotros') ? 'page' : undefined}>Nosotros</a></li>
    </ul>
    <a class="btn" href="/nosotros#visitanos">
      Visítanos en La Feria
      <span class="btn__arrow"><Icon name="arrow-right" size={18} /></span>
    </a>
  </div>
</header>

<style>
  .topbar {
    background: var(--blue);
    color: var(--ink-on-blue-2);
    font-size: 0.86rem;
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 40px;
  }
  .topbar__place {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .topbar__wa {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .topbar__wa a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .topbar__wa a:hover {
    background: rgb(255 255 255 / 0.14);
  }
  .topbar__wa li:first-child a {
    background: #fff;
    color: var(--blue);
  }
  .topbar__wa li:first-child a:hover {
    background: var(--blue-soft);
  }
  .topbar__label {
    font-weight: 500;
  }
  .topbar__wa strong {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  @media (max-width: 760px) {
    .topbar__place {
      display: none;
    }
    .topbar__inner {
      justify-content: center;
    }
  }
  @media (max-width: 430px) {
    .topbar__label {
      display: none;
    }
    .topbar__wa a {
      padding: 5px 10px;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: 14px;
    pointer-events: none;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 14px;
    pointer-events: auto;
  }

  .brand {
    flex: none;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #fff;
    box-shadow: var(--shadow-float);
  }
  .brand img {
    width: 62px;
    height: auto;
  }

  .nav {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 8px 8px 8px 20px;
    border-radius: 999px;
    background: #fff;
    box-shadow: var(--shadow-float);
  }
  .nav__list {
    display: flex;
    align-items: center;
    align-self: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    flex: 1;
  }
  .nav__item {
    display: flex;
    align-items: center;
  }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 16px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font: 500 0.98rem/1.2 var(--font-body);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .nav__link:hover,
  .nav__link[aria-expanded='true'] {
    color: var(--ink);
    background: var(--paper);
  }
  .nav__link[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }
  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--orange);
  }
  /* Pal' Arranque: píldora azul con sus letras, para marcar que es otra línea */
  .nav__link.nav__link--pa {
    margin: 0 4px;
    padding: 6px 16px 7px;
    background: var(--blue);
    line-height: 0;
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.3s var(--ease-out);
  }
  .nav__link.nav__link--pa:hover {
    background: var(--blue-hover);
    transform: translateY(-1px);
  }
  .nav__link.nav__link--pa[aria-current='page'] {
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--on-blue);
  }
  .nav__link.nav__link--pa[aria-current='page']::after {
    display: none;
  }
  .nav__item--mega .nav__link[aria-current='page']::after {
    margin-left: -10px;
  }
  .nav__link :global(.nav__chev) {
    transition: transform 0.3s var(--ease-out);
  }
  .nav__link[aria-expanded='true'] :global(.nav__chev) {
    transform: rotate(180deg);
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 20px 0 16px;
    border-radius: 999px;
    background: var(--dark);
    color: #fff;
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .nav__cta:hover {
    background: #0b111d;
  }

  /* ---------- Mega menú ---------- */
  .nav__item--mega {
    position: static;
  }
  .mega {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    padding: 14px 14px 18px;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 24px 60px -24px rgb(17 24 39 / 0.35), 0 2px 8px -2px rgb(17 24 39 / 0.08);
    transform-origin: top center;
    animation: mega-in 0.32s var(--ease-out);
  }
  @keyframes mega-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
      clip-path: inset(0 0 30% 0 round 22px);
    }
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 0 0 round 22px);
    }
  }
  .mega__grid {
    display: grid;
    grid-template-columns: 1fr 1.7fr;
    gap: 16px;
  }
  .mega__col {
    padding: 22px 24px 20px;
    border-radius: 16px;
  }
  .mega__col--pa {
    background: var(--blue);
    color: #fff;
  }
  .mega__col--tr {
    background: var(--orange);
    color: var(--on-orange-ink);
  }
  .mega__title {
    display: block;
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid currentColor;
    text-decoration: none;
  }
  .mega__col--pa .mega__title {
    border-color: rgb(255 255 255 / 0.3);
    line-height: 0;
  }
  .mega__title--tr {
    border-color: rgb(17 74 155 / 0.3);
    line-height: 0;
  }
  .mega__subs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  .mega__sub {
    display: block;
    margin-bottom: 6px;
    color: #fff;
    font-family: var(--font-sport);
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .mega__sub:hover {
    text-decoration: underline;
  }
  .mega__col ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mega__col li a {
    display: inline-flex;
    padding: 5px 0;
    font-size: 0.93rem;
    line-height: 1.35;
    text-decoration: none;
  }
  .mega__col--pa li a {
    color: var(--ink-on-blue-2);
  }
  .mega__col--tr li a {
    color: var(--on-orange-ink);
  }
  .mega__col li a:hover {
    color: inherit;
    text-decoration: underline;
  }
  .mega__col--pa li a:hover {
    color: #fff;
  }
  .mega__route {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 8px 14px;
    border-radius: 999px;
    background: #fff;
    color: var(--blue);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .mega__route:hover {
    box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.5);
  }
  .mega__all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 16px 0 0 10px;
    color: var(--primary);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .mega__all:hover {
    text-decoration: underline;
  }

  .nav__burger {
    display: none;
  }
  .mobile {
    display: none;
  }

  @media (max-width: 960px) {
    .mega__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .site-header {
      padding-top: 10px;
    }
    .brand {
      width: 60px;
      height: 60px;
    }
    .brand img {
      width: 48px;
    }
    .site-header__inner {
      justify-content: space-between;
    }
    .nav {
      flex: 0 0 auto;
      min-height: 56px;
      gap: 6px;
      padding: 6px;
    }
    .nav__list {
      display: none;
    }
    .nav__cta {
      min-height: 44px;
      padding: 0 16px 0 12px;
      font-size: 0.92rem;
    }
    .nav__burger {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 50%;
      background: var(--paper);
      color: var(--ink);
      cursor: pointer;
    }
    .nav__burger :global(.i-close),
    .nav__burger[aria-expanded='true'] :global(.i-open) {
      display: none;
    }
    .nav__burger[aria-expanded='true'] :global(.i-close) {
      display: block;
    }

    .mobile:not([hidden]) {
      display: block;
      pointer-events: auto;
      margin: 10px var(--gutter) 0;
      padding: 12px 20px 24px;
      max-height: calc(100dvh - 100px);
      overflow-y: auto;
      border-radius: 22px;
      background: #fff;
      box-shadow: var(--shadow-float);
      animation: mega-in 0.3s var(--ease-out);
    }
    .mobile__list {
      margin: 0 0 20px;
      padding: 0;
      list-style: none;
    }
    .mobile__list > li {
      border-bottom: 1px solid var(--line);
    }
    .mobile__list > li > a,
    .mobile summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 0;
      color: var(--ink);
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 600;
      text-decoration: none;
      list-style: none;
      cursor: pointer;
    }
    .mobile summary::-webkit-details-marker {
      display: none;
    }
    .mobile details[open] summary :global(svg) {
      transform: rotate(180deg);
    }
    .mobile__list a[aria-current='page'] {
      color: var(--primary);
    }
    .mobile__pa {
      display: inline-block;
      padding: 6px 16px 7px;
      border-radius: 999px;
      background: var(--blue);
      line-height: 0;
    }
    .mobile__list a[aria-current='page'] .mobile__pa {
      box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--on-blue);
    }
    .mobile__cats {
      display: grid;
      gap: 18px;
      padding: 0 0 20px;
    }
    .mobile__cat {
      display: inline-block;
      margin-bottom: 6px;
      padding: 3px 10px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.82rem;
    }
    .mobile__cat.is-pa {
      background: var(--blue);
      color: #fff;
    }
    .mobile__cat.is-tr {
      background: var(--orange);
      color: var(--on-orange);
    }
    .mobile__cats ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .mobile__cats li a {
      display: block;
      padding: 6px 0;
      color: var(--ink-2);
      text-decoration: none;
    }
    .mobile__all {
      color: var(--primary);
      font-weight: 600;
    }
  }

  @media (max-width: 360px) {
    .nav__cta {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-header]');
  const item = root?.querySelector<HTMLElement>('[data-mega]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-mega-toggle]');
  const panel = root?.querySelector<HTMLElement>('[data-mega-panel]');

  if (item && toggle && panel) {
    let closeTimer: number | undefined;
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    toggle.addEventListener('click', () => set(panel.hidden));

    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    item.addEventListener('mouseenter', () => {
      if (!fine.matches) return;
      window.clearTimeout(closeTimer);
      set(true);
    });
    item.addEventListener('mouseleave', () => {
      if (!fine.matches) return;
      closeTimer = window.setTimeout(() => set(false), 160);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        set(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!item.contains(e.target as Node)) set(false);
    });
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node)) set(false);
    });
  }

  const burger = root?.querySelector<HTMLButtonElement>('[data-burger]');
  const mobile = root?.querySelector<HTMLElement>('[data-mobile]');
  if (burger && mobile) {
    burger.addEventListener('click', () => {
      const open = mobile.hidden;
      mobile.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      burger.querySelector('.visually-hidden')!.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    });
  }
</script>
