---
import { Image } from 'astro:assets';
import ProductGlyph from './ProductGlyph.astro';
import Icon from './Icon.astro';
import LineaEtiqueta from './LineaEtiqueta.astro';
import SelloArtesanal from './SelloArtesanal.astro';
import { esPalArranque, productoUrl, type Producto } from '../data/productos';
import { fotosDe, faltaEmpaque } from '../data/fotos';

interface Props {
  producto: Producto;
  /** Oculta el párrafo de receta (carruseles compactos). */
  compacta?: boolean;
}

const { producto: p, compacta = false } = Astro.props;
const pa = esPalArranque(p);
const foto = fotosDe(p.slug)[0];
---

<article class:list={['pcard', pa ? 'pcard--pa' : 'pcard--tradicional', { 'pcard--compacta': compacta }]}>
  {
    foto ? (
      <div class="pcard__media pcard__media--foto">
        <Image
          class="pcard__foto"
          src={foto}
          alt={`${p.nombre}, empaque de ${pa ? "Pal' Arranque" : 'Agroferia Tradicional'}`}
          widths={[340, 680]}
          sizes={compacta ? '260px' : '(max-width: 600px) 90vw, 290px'}
        />
        {faltaEmpaque(p.slug) && <ProductGlyph name={p.glyph} size={96} class="pcard__glyph" />}
        {p.sello !== false && <SelloArtesanal fantasma class="pcard__sello" />}
      </div>
    ) : (
      <div class="pcard__media">
        <ProductGlyph name={p.glyph} size={96} class="pcard__glyph" />
        <LineaEtiqueta linea={p.linea} alto={compacta ? 29 : 34} cinta class="pcard__linea" />
        {p.sello !== false && <SelloArtesanal size={compacta ? 54 : 64} class="pcard__sello" />}
      </div>
    )
  }
  <div class="pcard__body">
    <h3 class="pcard__name">
      <a class="pcard__link" href={productoUrl(p)}>{p.nombre}</a>
    </h3>
    <p class="pcard__recipe">{compacta ? p.resumen : p.receta}</p>
    <span class="pcard__foot">
      <span class="pcard__format">{p.presentacion.split(',')[0]}</span>
      <span class="pcard__more" aria-hidden="true">
        Ver producto
        <span class="pcard__arrow"><Icon name="arrow-right" size={16} /></span>
      </span>
    </span>
  </div>
</article>

<style>
  .pcard {
    --line-color: var(--orange);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.3s ease, transform 0.4s var(--ease-out);
  }
  .pcard--pa {
    --line-color: var(--blue);
  }
  .pcard:hover,
  .pcard:focus-within {
    transform: translateY(-3px);
    border-color: var(--line-color);
    box-shadow: 0 18px 36px -20px rgb(17 24 39 / 0.35);
  }

  .pcard__media {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    aspect-ratio: 1 / 1;
    padding-top: 40px;
    background: var(--panel);
    color: var(--line-color);
  }
  /* Imagen compuesta (fondo + etiqueta + sello + empaque): se muestra completa, sin recortar */
  .pcard .pcard__media.pcard__media--foto {
    display: block;
    aspect-ratio: 337 / 276;
    padding: 0;
    background: #fff;
  }
  .pcard .pcard__media--foto :global(.pcard__foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pcard .pcard__media--foto :global(.pcard__glyph) {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 84px;
    height: 84px;
    translate: -50% -50%;
  }
  /* Botón invisible sobre el sello dibujado en la imagen */
  .pcard .pcard__media--foto :global(.pcard__sello) {
    right: 3%;
    bottom: 2%;
    width: 25%;
    height: auto;
    aspect-ratio: 1;
  }
  /* Carrusel de inicio: imagen más alta para que etiqueta, ícono y sello no se aprieten */
  .pcard--compacta .pcard__media {
    aspect-ratio: 1 / 1;
    padding-top: 36px;
    padding-bottom: 0;
  }
  .pcard--compacta .pcard__media :global(.pcard__glyph) {
    width: 70px;
    height: 70px;
  }
  .pcard__media > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pcard__media :global(.pcard__glyph) {
    transition: transform 0.5s var(--ease-out);
  }
  .pcard:hover .pcard__media :global(.pcard__glyph) {
    transform: scale(1.06) rotate(-3deg);
  }
  .pcard__media :global(.pcard__linea) {
    position: absolute;
    z-index: 1;
    top: 12px;
    left: 12px;
  }
  /* Sello artesanal: esquina inferior derecha de la imagen, por encima del enlace de la tarjeta */
  .pcard__media :global(.pcard__sello) {
    position: absolute;
    z-index: 2;
    right: 10px;
    bottom: 10px;
  }

  .pcard__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 18px 18px 16px;
  }
  .pcard__name {
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .pcard__link {
    color: inherit;
    text-decoration: none;
  }
  /* Toda la tarjeta es clicable; el sello queda por encima con su propio clic */
  .pcard__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .pcard__link:focus-visible {
    outline: none;
  }
  .pcard:has(.pcard__link:focus-visible) {
    outline: 3px solid var(--line-color);
    outline-offset: 3px;
  }
  .pcard__recipe {
    color: var(--ink-2);
    font-size: 0.93rem;
    line-height: 1.55;
  }
  .pcard__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .pcard__format {
    color: var(--ink-2);
    font-size: 0.82rem;
  }
  .pcard__more {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
    color: var(--blue);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .pcard__arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    transition: transform 0.35s var(--ease-out);
  }
  .pcard--tradicional .pcard__arrow {
    background: var(--orange);
    color: var(--on-orange);
  }
  .pcard:hover .pcard__arrow {
    transform: translateX(3px);
  }
</style>
