---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categorias, productosDe } from '../../data/productos';
---

<Base title="Productos" description="Leches, bebidas y alimentos lácteos, quesos, snacks, postres y la línea Pal' Arranque de Agroferia.">
  <section class="container phero" aria-labelledby="ph-title">
    <h1 id="ph-title">Nuestros productos</h1>
    <p class="lead">
      Todo lo que hacemos con la leche de La Feria. Entra a cada producto para ver sus ingredientes, cómo conservarlo y su
      información nutricional.
    </p>
  </section>

  <nav class="catnav" aria-label="Categorías de productos">
    <div class="container catnav__inner">
      {
        categorias.map((c) => (
          <a class:list={['catnav__link', { 'catnav__link--pa': c.key === 'pal-arranque' }]} href={`#${c.key}`}>
            {c.nombre}
          </a>
        ))
      }
    </div>
  </nav>

  {
    categorias.map((c) => {
      const lista = productosDe(c.key);
      const pa = c.key === 'pal-arranque';
      return (
        <section id={c.key} class:list={['cat', { 'cat--pa': pa }]} aria-labelledby={`t-${c.key}`}>
          <div class="container">
            <div class="cat__head">
              <div>
                <h2 id={`t-${c.key}`}>{c.nombre}</h2>
                <p>{c.descripcion}</p>
              </div>
              {pa && (
                <a class="btn btn--sun" href="/pal-arranque">
                  Conoce el programa
                  <span class="btn__arrow">
                    <Icon name="arrow-right" size={18} />
                  </span>
                </a>
              )}
            </div>
            <ul class="grid">
              {lista.map((p) => (
                <li>
                  <ProductCard producto={p} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  .phero {
    padding: clamp(56px, 8vw, 104px) 0 clamp(32px, 4vw, 48px);
  }
  .phero .lead {
    margin-top: 18px;
  }

  .catnav {
    position: sticky;
    top: 96px;
    z-index: 10;
    padding: 10px 0;
    background: var(--paper);
  }
  .catnav__inner {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .catnav__inner::-webkit-scrollbar {
    display: none;
  }
  .catnav__link {
    flex: none;
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .catnav__link:hover {
    border-color: var(--green);
  }
  .catnav__link--pa {
    border-color: var(--green-deep);
    background: var(--green-deep);
    color: var(--sun);
    font-family: var(--font-sport);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .catnav__link--pa:hover {
    background: var(--green);
  }

  .cat {
    padding: clamp(40px, 6vw, 72px) 0;
    scroll-margin-top: 150px;
  }
  .cat + .cat {
    border-top: 1px solid var(--line);
  }
  .cat__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 20px 40px;
    margin-bottom: 28px;
  }
  .cat__head h2 {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  }
  .cat__head p {
    margin-top: 8px;
    max-width: 60ch;
    color: var(--ink-2);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cat--pa {
    margin: 24px auto;
    width: min(100% - 2 * var(--gutter) + 0px, calc(var(--container) + 64px));
    padding-inline: 0;
    border-radius: var(--r-frame);
    background: var(--green-deep);
    border-top: 0 !important;
  }
  .cat--pa + .cat {
    border-top: 0;
  }
  .cat--pa .container {
    width: min(100% - 2 * var(--gutter), var(--container));
  }
  .cat--pa h2 {
    color: var(--sun);
    font-family: var(--font-sport);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .cat--pa .cat__head p {
    color: var(--ink-on-dark-2);
  }

  @media (max-width: 860px) {
    .catnav {
      top: 76px;
    }
    .cat--pa {
      width: 100%;
      border-radius: 0;
    }
  }
</style>
