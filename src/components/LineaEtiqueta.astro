---
/**
 * Etiqueta de línea de producto con las letras oficiales en imagen:
 * Pal' Arranque = píldora azul con sus letras; Agroferia Tradicional = píldora naranja con letras azules.
 * Es la única forma de etiqueta de línea en el sitio (tarjetas, fichas, menú).
 */
import { Image } from 'astro:assets';
import letrasPA from '../assets/marca/pal-arranque-letras.png';
import letrasTR from '../assets/marca/tradicional-letras.png';
import type { LineaKey } from '../data/productos';

interface Props {
  linea: LineaKey;
  /** Alto visible de las letras en px. */
  alto?: number;
  /** Cinta con borde dentado arriba y abajo (como las etiquetas de empaque). Por defecto, píldora. */
  cinta?: boolean;
  class?: string;
  loading?: 'eager' | 'lazy';
}
const { linea, alto = 18, cinta = false, class: className, loading = 'lazy' } = Astro.props;
const pa = linea === 'pal-arranque';
const src = pa ? letrasPA : letrasTR;
const ancho = Math.round((alto * src.width) / src.height);

// Cinta: recorte triangulado en los lados izquierdo y derecho, calculado en px según el tamaño.
const padX = Math.round(alto * 0.5);
const padY = Math.round(alto * 0.2);
const W = ancho + padX * 2;
const H = alto + padY * 2;
const dientes = Math.max(4, Math.round(H / (alto * 0.36)));
const th = H / dientes;
const d = Math.round(alto * 0.16 * 10) / 10;
const f = (n: number) => Math.round(n * 10) / 10;
const pts: string[] = [`${d}px 0`, `${f(W - d)}px 0`];
for (let i = 0; i < dientes; i++) pts.push(`${f(W)}px ${f(i * th + th / 2)}px`, `${f(W - d)}px ${f((i + 1) * th)}px`);
pts.push(`${d}px ${f(H)}px`);
for (let i = dientes - 1; i >= 0; i--) pts.push(`0px ${f(i * th + th / 2)}px`, `${d}px ${f(i * th)}px`);
const recorte = cinta ? `clip-path:polygon(${pts.join(',')});padding:${padY}px ${padX}px;` : '';
---

<span class:list={['etiqueta', pa ? 'etiqueta--pa' : 'etiqueta--tr', { 'etiqueta--cinta': cinta }, className]} style={`--alto:${alto}px;${recorte}`}>
  <Image
    src={src}
    alt={pa ? "Pal' Arranque" : 'Agroferia Tradicional'}
    width={Math.min(ancho * 2, src.width)}
    style={`height:${alto}px;width:${ancho}px`}
    loading={loading}
  />
</span>

<style>
  .etiqueta {
    display: inline-flex;
    flex: none;
    align-items: center;
    padding: calc(var(--alto) * 0.3) calc(var(--alto) * 0.62);
    border-radius: 999px;
    line-height: 0;
  }
  .etiqueta--pa {
    background: var(--blue);
  }
  .etiqueta--tr {
    background: var(--orange);
  }
  .etiqueta--cinta {
    border-radius: 0;
  }
  .etiqueta :global(img) {
    display: block;
    max-width: none;
  }
</style>
